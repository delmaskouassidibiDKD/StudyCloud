{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@gadgets/typed-storage": ["../typed-storage/src/index.ts"],
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
